---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Page not found — Index Us" description="The requested page could not be found on Index Us.">
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <header class="shell page-head">
    <p class="eyebrow">Error 404</p>
    <h1 class="page-title">This signal went missing.</h1>
    <p class="dek">The page may have moved, or the address may be incorrect. Return to the <a href="/">homepage</a> or browse <a href="/articles/">all articles</a>.</p>
  </header>
</BaseLayout>
