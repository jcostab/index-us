---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
const articles = (await getCollection("articles", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const categories = ["News", "Tools", "Techniques", "Analysis", "Guides"];
---
<BaseLayout title="All articles — Index Us" description="Browse independent AI news, tool reviews, analysis and practical guides from Index Us.">
  <header class="shell archive-head">
    <div>
      <p class="eyebrow">The reading room</p>
      <h1>All articles<span aria-hidden="true">.</span></h1>
    </div>
    <p class="archive-dek">Reporting, analysis and practical techniques for making sense of a fast-moving AI industry.</p>
  </header>
  <section class="shell archive" aria-label="Article archive" data-archive>
    <div class="archive-controls" data-archive-controls hidden>
      <div class="archive-categories" role="group" aria-label="Filter by category">
        <button type="button" class="category-filter" data-category="All" aria-pressed="true">All <span>{articles.length}</span></button>
        {categories.map((category) => (
          <button type="button" class="category-filter" data-category={category} aria-pressed="false">
            {category} <span>{articles.filter((article) => article.data.category === category).length}</span>
          </button>
        ))}
      </div>
      <label class="archive-search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 5 5" /></svg>
        <span class="archive-sr-only">Search articles</span>
        <input type="search" name="q" placeholder="Find something worth reading" autocomplete="off" data-archive-search />
      </label>
    </div>
    <div class="archive-status-row">
      <p data-archive-status role="status" aria-live="polite" aria-atomic="true">{articles.length} articles</p>
      <span>Latest first</span>
    </div>
    <div class="archive-grid">
      {articles.map((article) => (
        <div class="archive-entry" data-archive-entry data-category={article.data.category} data-search={[article.data.title, article.data.description, ...article.data.tags].join(" ").toLocaleLowerCase("en-AU")}>
          <ArticleCard article={article} headingLevel="h2" />
        </div>
      ))}
    </div>
    <div class="archive-empty" data-archive-empty hidden>
      <p class="eyebrow">A little further afield</p>
      <h2>No articles found.</h2>
      <p>Try another search or explore the full index.</p>
      <button type="button" data-archive-reset>Show all articles <span aria-hidden="true">↗</span></button>
    </div>
    <noscript><p class="archive-no-script">You're viewing the complete index. Enable JavaScript to search and filter the articles.</p></noscript>
  </section>
</BaseLayout>

<script>
  const archive = document.querySelector<HTMLElement>("[data-archive]");
  if (archive) {
    const controls = archive.querySelector<HTMLElement>("[data-archive-controls]");
    const search = archive.querySelector<HTMLInputElement>("[data-archive-search]");
    const buttons = Array.from(archive.querySelectorAll<HTMLButtonElement>("button[data-category]"));
    const entries = Array.from(archive.querySelectorAll<HTMLElement>("[data-archive-entry]"));
    const status = archive.querySelector<HTMLElement>("[data-archive-status]");
    const empty = archive.querySelector<HTMLElement>("[data-archive-empty]");
    let category = "All";

    const filter = (updateUrl = true) => {
      const query = search?.value.trim().toLocaleLowerCase("en-AU") ?? "";
      let count = 0;
      for (const entry of entries) {
        const matches = (category === "All" || entry.dataset.category === category) && (entry.dataset.search ?? "").includes(query);
        entry.hidden = !matches;
        if (matches) count += 1;
      }
      for (const button of buttons) button.setAttribute("aria-pressed", String(button.dataset.category === category));
      for (const link of document.querySelectorAll<HTMLAnchorElement>('.site-nav a, .mobile-menu nav a')) {
        const target = new URL(link.href);
        const selected = target.pathname === '/articles/' && (target.searchParams.get('category') ?? 'All') === category;
        if (selected) link.setAttribute('aria-current', 'page');
        else link.removeAttribute('aria-current');
      }
      if (status) status.textContent = `${count} ${count === 1 ? "article" : "articles"}${category !== "All" ? ` in ${category}` : ""}${query ? ` matching “${search?.value.trim()}”` : ""}`;
      if (empty) empty.hidden = count > 0;
      if (updateUrl) {
        const url = new URL(window.location.href);
        category === "All" ? url.searchParams.delete("category") : url.searchParams.set("category", category);
        query ? url.searchParams.set("q", search?.value.trim() ?? "") : url.searchParams.delete("q");
        window.history.replaceState(null, "", url);
      }
    };

    const readUrl = () => {
      const params = new URLSearchParams(window.location.search);
      const requested = params.get("category");
      category = buttons.find((button) => button.dataset.category?.toLowerCase() === requested?.toLowerCase())?.dataset.category ?? "All";
      if (search) search.value = params.get("q") ?? "";
      filter(false);
    };

    for (const button of buttons) button.addEventListener("click", () => {
      category = button.dataset.category ?? "All";
      filter();
    });
    search?.addEventListener("input", () => filter());
    archive.querySelector("[data-archive-reset]")?.addEventListener("click", () => {
      category = "All";
      if (search) search.value = "";
      filter();
      search?.focus();
    });
    window.addEventListener("popstate", readUrl);
    readUrl();
    if (controls) controls.hidden = false;
  }
</script>

<style>
  .archive-head { display: grid; grid-template-columns: 1.3fr 1fr; align-items: end; gap: 3rem; padding-block: clamp(3rem, 7vw, 6rem) 3rem; }
  .archive-head h1 { margin: 0; font-family: var(--serif); font-size: clamp(4rem, 8vw, 7.5rem); line-height: .95; font-weight: 400; letter-spacing: -.055em; }
  .archive-head h1 > span { color: var(--accent, #ed512f); }
  .archive-dek { max-width: 29rem; margin: 0 0 .25rem auto; font-size: clamp(1rem, 1.7vw, 1.2rem); line-height: 1.65; color: var(--muted); }
  .archive { padding-bottom: clamp(4rem, 8vw, 7rem); }
  .archive-controls { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.5rem; padding-block: 1.25rem; border-block: 1px solid var(--rule); }
  .archive [hidden] { display: none !important; }
  .archive-categories { display: flex; flex-wrap: wrap; gap: .35rem; }
  .category-filter { display: inline-flex; gap: .5rem; align-items: center; border: 1px solid transparent; background: none; padding: .6rem .85rem; border-radius: 3px; font: 500 .8rem var(--sans); color: var(--ink); cursor: pointer; transition: background-color .2s, color .2s; }
  .category-filter span { font-size: .6rem; opacity: .7; }
  .category-filter:hover { background: #e6e4dc; }
  .category-filter[aria-pressed="true"] { color: var(--paper); background: var(--ink); }
  .archive-search { display: flex; align-items: center; gap: .6rem; flex: 0 1 19rem; border-bottom: 1px solid var(--rule); padding: .65rem 0; }
  .archive-search svg { flex-shrink: 0; }
  .archive-search input { width: 100%; min-width: 0; border: 0; background: transparent; font: .8rem var(--sans); color: var(--ink); padding: .15rem; border-radius: 0; }
  .archive-search input::placeholder { color: var(--muted); opacity: 1; }
  .archive-status-row { display: flex; gap: 1rem; justify-content: space-between; align-items: baseline; padding-block: 1.5rem; font-size: .7rem; color: var(--muted); }
  .archive-status-row p { margin: 0; }
  .archive-status-row > span { flex-shrink: 0; }
  .archive-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 3rem 1.75rem; }
  .archive-entry { min-width: 0; }
  .archive-entry :global(.card) { height: 100%; }
  .archive-empty { padding: 5rem 1rem; text-align: center; border-block: 1px solid var(--rule); }
  .archive-empty h2 { margin: 0; font-family: var(--serif); font-size: clamp(2.5rem, 6vw, 4rem); font-weight: 400; letter-spacing: -.04em; }
  .archive-empty > p:not(.eyebrow) { color: var(--muted); }
  .archive-empty button { margin-top: 1rem; border: 0; border-bottom: 1px solid currentColor; padding: .5rem 0; background: none; color: var(--ink); font: 600 .85rem var(--sans); cursor: pointer; }
  .archive-empty button > span { margin-left: 1rem; }
  .archive-no-script { margin-top: 2rem; font-size: .8rem; color: var(--muted); }
  .archive-sr-only { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; }
  @media (max-width: 1050px) { .archive-controls { align-items: stretch; } .archive-search { flex-basis: 100%; max-width: 26rem; } }
  @media (max-width: 850px) { .archive-head { grid-template-columns: 1fr; gap: 1.5rem; } .archive-dek { margin: 0; } .archive-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .archive-grid { grid-template-columns: 1fr; gap: 2rem; } .archive-head { padding-bottom: 2rem; } .category-filter { padding: .65rem .7rem; } }
</style>
