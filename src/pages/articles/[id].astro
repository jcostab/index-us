---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE, formatDate } from "../../lib/site";

export async function getStaticPaths() {
  const articles = await getCollection("articles", ({ data }) => !data.draft);
  return articles.map((article) => ({ params: { id: article.id }, props: { article } }));
}

interface Props { article: CollectionEntry<"articles">; }
const { article } = Astro.props;
const { Content } = await render(article);
const canonical = `/articles/${article.id}/`;
const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: article.data.title,
  description: article.data.description,
  datePublished: article.data.publishedAt.toISOString(),
  dateModified: article.data.updatedAt.toISOString(),
  inLanguage: SITE.language,
  mainEntityOfPage: new URL(canonical, SITE.url).href,
  author: { "@type": "Organization", name: article.data.author },
  publisher: { "@type": "Organization", name: SITE.name, url: SITE.url },
  keywords: article.data.tags.join(", "),
  articleSection: article.data.category,
  isPartOf: { "@type": "Blog", name: `${SITE.name} Articles`, url: new URL("/articles/", SITE.url).href },
  citation: article.data.sources.map((source) => source.url),
};
---
<BaseLayout title={`${article.data.title} — Index Us`} description={article.data.description} canonical={canonical} type="article">
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />
  <article>
    <header class="shell article-head">
      <p class="eyebrow">{article.data.category}</p>
      <h1>{article.data.title}</h1>
      <p class="article-dek">{article.data.description}</p>
      <div class="article-byline">
        <span>By {article.data.author}</span>
        <time datetime={article.data.publishedAt.toISOString()}>Published {formatDate(article.data.publishedAt)}</time>
        <span>{article.data.readingMinutes} min read</span>
      </div>
    </header>
    <div class="prose">
      <aside class="takeaways" aria-labelledby="takeaways-title">
        <h2 id="takeaways-title">Key takeaways</h2>
        <ul>{article.data.keyTakeaways.map((item) => <li>{item}</li>)}</ul>
      </aside>
      <Content />
      <h2>Sources</h2>
      <ol class="source-list">
        {article.data.sources.map((source) => <li><a href={source.url} rel="noreferrer">{source.label}</a></li>)}
      </ol>
      <p><small>Last reviewed: <time datetime={article.data.updatedAt.toISOString()}>{formatDate(article.data.updatedAt)}</time>. See our <a href="/editorial-policy/">editorial policy</a> for how we test, source and correct our work.</small></p>
    </div>
  </article>
</BaseLayout>
