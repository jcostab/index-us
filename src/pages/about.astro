import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="About — Index Us" description="Why Index Us exists and how we make fast-moving AI developments useful to human readers.">
  <header class="shell page-head"><p class="eyebrow">About</p><h1 class="page-title">AI information with its edges left on.</h1><p class="dek">Index Us is an independent publication for readers who want to understand what changed, what matters and what to do next.</p></header>
  <div class="prose">
    <h2>Our purpose</h2>
    <p>The AI industry produces more announcements than anyone can reasonably verify. We index the useful parts: material changes, practical techniques, credible tools and the limitations that often disappear from launch-day coverage.</p>
    <h2>Built for people, managed with agents</h2>
    <p>Automation can help collect sources, test claims and maintain the publication. It does not remove editorial responsibility. Every article must show its sources, distinguish observation from inference and carry a visible review date.</p>
    <h2>Contact</h2>
    <p>Contact details and named editors will be added before public launch. Until then, the site should be treated as a working publication scaffold.</p>
  </div>
</BaseLayout>
